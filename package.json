{
  "name": "cardiology-app",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:authoring": "vite --mode authoring",
    "build": "vite build",
    "build:authoring": "vite build --mode authoring --outDir dist-authoring",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:visual": "playwright test --project=desktop-chromium",
    "test:release": "playwright test --project=desktop-chromium",
    "test:visual:update": "playwright test --project=desktop-chromium --update-snapshots",
    "test:phone": "playwright test --project=phone-portrait",
    "test:phone:update": "playwright test --project=phone-portrait --update-snapshots",
    "bench:echo": "node tests/perf/echo-bench.mjs",
    "measure:echo": "node tests/perf/echo-fill.mjs",
    "validate:packs": "tsx scripts/validate-packs.ts",
    "check:provenance": "tsx scripts/check-provenance.ts",
    "check:view-candidates": "tsx scripts/check-view-candidates.ts",
    "check:base-path": "tsx scripts/check-base-path.ts",
    "check:published-packs": "tsx scripts/check-published-packs.ts",
    "check:authoring-absent": "tsx scripts/check-authoring-absent.ts",
    "check:absolute-paths": "node scripts/check-absolute-paths.mjs",
    "add:404": "node scripts/add-404.mjs",
    "gen:stub-assets": "node scripts/make-stub-assets.mjs",
    "check:stub-assets": "npm run gen:stub-assets && git diff --exit-code -- public/packs/stub",
    "ingest": "conda run --no-capture-output -n cardiology-app python pipeline/ingest.py",
    "ingest:fetch": "conda run --no-capture-output -n cardiology-app python pipeline/fetch.py",
    "ingest:authoring": "tsx scripts/ingest-authoring-export.ts",
    "check:fast": "npm run typecheck && npm run lint && npm run test",
    "check:content": "npm run validate:packs && npm run check:provenance && npm run check:pack-budget && npm run check:view-candidates && npm run check:frame-decoupling",
    "verify": "npm run check:fast && npm run build && npm run build:authoring",
    "verify:release": "npm run verify && npm run check:content && npm run check:stub-assets && npm run check:absolute-paths && npm run check:base-path && npm run check:published-packs && npm run check:authoring-absent && npm run test:release",
    "check:frame-decoupling": "tsx scripts/check-frame-decoupling.ts",
    "check:body-context": "conda run --no-capture-output -n cardiology-app python pipeline/body_context.py --check",
    "ingest:authoring:batch": "tsx scripts/ingest-authoring-batch.ts",
    "check:pack-budget": "tsx scripts/check-pack-budget.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
