{
  "name": "cardiology-app",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "bench:echo": "node tests/perf/echo-bench.mjs",
    "measure:echo": "node tests/perf/echo-fill.mjs",
    "validate:packs": "tsx scripts/validate-packs.ts",
    "check:provenance": "tsx scripts/check-provenance.ts",
    "check:base-path": "tsx scripts/check-base-path.ts",
    "check:published-packs": "tsx scripts/check-published-packs.ts",
    "gen:stub-assets": "node scripts/make-stub-assets.mjs",
    "ingest": "conda run --no-capture-output -n cardiology-app python pipeline/ingest.py",
    "ingest:fetch": "conda run --no-capture-output -n cardiology-app python pipeline/fetch.py",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run validate:packs && npm run check:provenance"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
